{
  "proxies": {
    "tcp-forwarder": {
      "mode": "plain",
      "listen": "127.0.0.1:8000",
      "connect": "127.0.0.1:9000"
    },
    "pcap-test": {
      "mode": "plain",
      "listen": "127.0.0.1:8000",
      "connect": "127.0.0.1:8100",
      "interceptors": [
        "pcapdump"
      ]
    },
    "dbdump-test": {
      "mode": "plain",
      "listen": "127.0.0.1:8000",
      "x-connect": "212.102.35.236:443",
      "connect": "127.0.0.1:8100",
      "interceptors": [
        "dbdump"
      ]
    },
    "tamper-test": {
      "mode": "plain",
      "listen": "127.0.0.1:8000",
      "connect": "127.0.0.1:8100",
      "interceptors": [
        "tamper"
      ]
    },
    "example-match-replace": {
      "mode": "plain",
      "listen": "127.0.0.1:8001",
      "connect": "127.0.0.1:9001",
      "interceptors": [
        "match-replace-demo"
      ]
    },
    "example-tls-basic": {
      "mode": "tls",
      "listen": "127.0.0.1:1337",
      "connect": "127.0.0.1:1338",
      "logtime": true,
      "server": "basic-server",
      "client": "basic-client",
      "interceptors": [
        "hexdump"
      ]
    },
    "example-droptls": {
      "mode": "detecttls",
      "listen": "127.0.0.1:8000",
      "connect": "127.0.0.1:8100",
      "server": "basic-server",
      "client": "basic-client",
      "interceptors": [
        "droptls"
      ]
    },
    "example-tls-mux": {
      "mode": "tls-mux",
      "listen": "127.0.0.1:443",
      "connect": "127.0.0.1:9443",
      "server": "basic-server",
      "client": "basic-client",
      "logtime": true,
      "loglevel": "debug",
      "interceptors": [
        "hexdump"
      ],
      "mux": {
        "nmap": {
          "sni-matches": [
            ".*curl.se.*"
          ],
          "connect": "151.101.65.91:443",
          "server": "alpn-server",
          "client": "passthrough-client",
          "interceptors": [
            "dbdump"
          ]
        },
        "example": {
          "sni-matches": [
            "example.org"
          ],
          "connect": "104.20.26.136:443",
          "server": "alpn-server",
          "client": "passthrough-client",
          "interceptors": [
            "hexdump"
          ]
        }
      }
    },
    "test-alpn-passthrough": {
      "mode": "tls",
      "listen": "127.0.0.1:8000",
      "connect": "127.0.0.1:8100",
      "loglevel": "debug",
      "server": "alpn-probe-server",
      "client": "passthrough-client"
    },
    "test-example.org": {
      "mode": "tls",
      "listen": "127.0.0.1:8443",
      "connect": "104.18.2.24:443",
      "loglevel": "info",
      "server": "alpn-server",
      "client": "passthrough-client",
      "comment": "test with: curl -iks https://127.0.0.1:8443/ -H 'Host: example.org'"
    },
    "test-passthrough": {
      "mode": "tls",
      "listen": "127.0.0.1:8443",
      "connect": "50.116.1.184:443",
      "server": "basic-server",
      "client": "passthrough-client",
      "comment": "resolve nmap.org to 127.0.0.1; test with: curl -iks https://nmap.org:8443/ -H 'Host: nmap.org'"
    }
  },
  "tls-server-configs": {
    "basic-server": {
      "cert-pem": "test/certs/server.pem",
      "cert-key": "test/certs/server.key",
      "keylog": "key.log"
    },
    "alpn-server": {
      "cert-pem": "test/certs/server.pem",
      "cert-key": "test/certs/server.key",
      "alpn-preference": [
        "h2",
        "http/1.1"
      ],
      "keylog": "key.log"
    },
    "alpn-probe-server": {
      "cert-pem": "test/certs/server.pem",
      "cert-key": "test/certs/server.key",
      "max-version": "1.2",
      "min-version": "1.0",
      "alpn-probe": true,
      "alpn-probe-cache": false
    }
  },
  "tls-client-configs": {
    "basic-client": {
      "skip-verify": true,
      "sni-passthrough": true,
      "alpn-passthrough": true,
      "keylog": "key.log"
    },
    "demo-client": {
      "alpn": [
        "test",
        "alpn is fun"
      ],
      "server-name": "server.local",
      "cert-pem": "test/certs/client-int-1-chain.pem",
      "cert-key": "test/certs/client-int-1.key",
      "skip-verify": true,
      "keylog": "key.log"
    },
    "sni-alpn-demo-client": {
      "server-name": "nmap.org",
      "alpn": [
        "test"
      ],
      "skip-verify": true
    },
    "passthrough-client": {
      "sni-passthrough": true,
      "alpn-passthrough": true,
      "skip-verify": true,
      "max-version": "1.3",
      "min-version": "1.0"
    }
  },
  "api": {
    "listen": "127.0.0.1:9090"
  },
  "interceptors": {
    "hexdump": {
      "name": "hexdump"
    },
    "droptls": {
      "name": "droptls"
    },
    "pcapdump": {
      "name": "pcapdump",
      "args": {
        "file": "dump.pcap",
        "truncate": true
      }
    },
    "dbdump": {
      "name": "dbdump",
      "args": {
        "file": "dump.sqlite",
        "truncate": false,
	"scripts-dir": "examples/dbdump/framer"
      }
    },
    "tamper": {
      "name": "tamper",
      "args": {
        "hold-timeout-ms": 0,
        "hold-until-connected": false,
        "scripts-dir": "examples/tamper/scripts",
	"log-file": "/tmp/tamper.log"
      }
    },
    "match-replace-demo": {
      "name": "match-replace",
      "args": {
        "replacements": [
          {
            "one": "1"
          },
          {
            "delete[0-9]*": ""
          }
        ]
      }
    }
  }
}
