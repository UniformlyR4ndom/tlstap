{
    "tls-updown": {
        "listen": "127.0.0.1:8100",
        "trigger-upgrade": "starttls",
        "trigger-downgrade": "stoptls",
        "trigger-downgrade-c2s": "tlsstop-c2s",
        "trigger-downgrade-s2c": "tlsstop-s2c",
        "tls-config": {
            "cert-pem": "../certs/server.pem",
            "cert-key": "../certs/server.key"
        }
    },
    "mtls-forced": {
        "listen": "127.0.0.1:8100",
        "trigger-upgrade": "tls",
        "trigger-downgrade": "stoptls",
        "trigger-downgrade-c2s": "c2s-plain",
        "trigger-downgrade-s2c": "s2c-plain",
        "tls-config": {
            "cert-pem": "../certs/server.pem",
            "cert-key": "../certs/server.key",
            "client-roots": "../certs/ca.pem",
            "client-auth": "require-and-verify",
            "min-version": "1.0",
            "max-version": "1.3"
        }
    },
    "bulk-test": {
        "listen": "127.0.0.1:8100",
        "trigger-upgrade": "unused",
        "trigger-downgrade": "stoptls",
        "trigger-downgrade-c2s": "c2s-plain",
        "trigger-downgrade-s2c": "s2c-plain",
        "tls-config": {
            "cert-pem": "../certs/server.pem",
            "cert-key": "../certs/server.key"
        }
    }
}
